<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>TouchDeck.App</RootNamespace>
    <AssemblyName>TouchDeck</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TouchDeck.Core\TouchDeck.Core.csproj" />
    <ProjectReference Include="..\TouchDeck.Platform\TouchDeck.Platform.csproj" />
    <ProjectReference Include="..\TouchDeck.Actions\TouchDeck.Actions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
