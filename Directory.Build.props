<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Required only on public interfaces per the coding
         standards, so the blanket warning is downgraded rather than enforced. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Product>TouchDeck</Product>
    <Company>TouchDeck</Company>
    <Version>0.1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- WPF text input needs real culture data, so invariant globalisation stays off. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
